{
  "DevBeast": {
    "DefaultProjectPath": "",
    "Database": {
      "Provider": "MongoDB",
      "ConnectionString": ""
    },
    "Mongo": {
      "ConnectionString": "mongodb://devbeast_app:devbeast_app@localhost:27018/devbeast?authSource=devbeast",
      "DatabaseName": "devbeast"
    },
    "Logs": {
      "Provider": "File",
      "Directory": "/tmp/devbeast-logs",
      "FilePattern": "*.log"
    },
    "Redis": {
      "ConnectionString": "localhost:6379",
      "UseMockWhenUnavailable": true
    },
    "Integrations": {
      "Mode": "Mock",
      "MockDataPath": "Mocks"
    },
    "Scaffolding": {
      "OutputRoot": "",
      "NamespacePrefix": "App"
    }
  }
}
